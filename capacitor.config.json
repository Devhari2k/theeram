{
	"appId": "com.theeram.app",
	"appName": "Theeram",
	"webDir": "www",
	"backgroundColor": "#0B2027",
	"server": {
		"androidScheme": "https"
	},
	"plugins": {
		"PushNotifications": {
			"presentationOptions": ["alert", "badge", "sound"]
		},
		"SocialLogin": {
			"providers": {
				"google": true,
				"facebook": false,
				"apple": false,
				"twitter": false
			}
		}
	}
}
